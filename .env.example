APP_NAME="SIDA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sida.smkplusmelati.sch.id

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (MySQL recommended for Production VPS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vela_dms
DB_USERNAME=vela_user
DB_PASSWORD=your_strong_password

# Or SQLite (Development)
# DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Python OCR & AI Microservice (Running locally on Port 5000)
OCR_API_URL=http://127.0.0.1:5000/api/ocr

# Groq API for Document JSON Structuring
GROQ_API_KEY=

# Hyperledger Fabric 2.5 Config (Optional / Mock mode if disabled)
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_CHANNEL=documentchannel
FABRIC_CHAINCODE=documentCC
FABRIC_MSP_ID=Org1MSP
FABRIC_TLS_CERT=storage/fabric/tls-ca-cert.pem
FABRIC_MSP_CERT=storage/fabric/admin-cert.pem
FABRIC_MSP_KEY=storage/fabric/admin-key.pem
FABRIC_API_URL=http://localhost:5001/api/fabric/register
FABRIC_API_URL_VERIFY=http://localhost:5001/api/fabric/verify

# Google Drive Integration (OAuth2 Web Application)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/admin/google-drive/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_API_KEY=
